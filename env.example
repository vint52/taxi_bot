# Telegram
TG_TOKEN=your_telegram_bot_token_here
TG_ADMIN_ID=your_telegram_user_id
TG_LOG=/logs/tg.log

# Redis (the same password is used by the redis container itself)
RDS_HOST=redis
RDS_PASSWORD=your_redis_password
RDS_PORT=6379
RDS_DB=0

# Taxi cabinet
TXI_USERNAME=your_taxi_username
TXI_PASSWORD=your_taxi_password
# Polling interval in minutes
TXI_UPDATE_PERIOD=25

# Optional
# Directory for HTML dumps when the cabinet page cannot be parsed
DEBUG_HTML_DIR=/tmp/taxi_debug
# Secret code new users must send; leave empty for a public bot
BOT_SECRET_CODE=
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
# Timezone for the "last update" line shown to the administrator
BOT_TIMEZONE=Europe/Moscow
