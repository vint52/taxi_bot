# Telegram Bot Configuration
TG_TOKEN=your_telegram_bot_token_here
TG_ADMIN_ID=your_telegram_user_id
TG_LOG=/logs/tg.log

# Redis Configuration
RDS_HOST=redis
RDS_PASSWORD=your_redis_password
RDS_PORT=6379
RDS_DB=0

# Taxi Service Configuration
TXI_USERNAME=your_taxi_username
TXI_PASSWORD=your_taxi_password
TXI_UPDATE_PERIOD=25  # Update interval in minutes

# Debug settings
DEBUG_HTML_DIR=/tmp/taxi_debug  # Directory for HTML dumps on parse errors

# Bot access settings
BOT_SECRET_CODE=your_secret_code  # Secret code for new users to access the bot

